	xz [shape=box, label=<<TABLE><TR><TD>idx</TD><TD>derivatives</TD><TD>locations</TD><TD>values</TD></TR><TR><TD>0</TD><TD>0.015</TD><TD>-1.0</TD><TD>-0.02</TD></TR><TR><TD>1</TD><TD>0.0</TD><TD>-0.4</TD><TD>0.01</TD></TR><TR><TD>2</TD><TD>0.0</TD><TD>0.0</TD><TD>0.01</TD></TR><TR><TD>3</TD><TD>0.04</TD><TD>0.4</TD><TD>0.03</TD></TR><TR><TD>4</TD><TD>0.049</TD><TD>1.0</TD><TD>0.1</TD></TR></TABLE>>, tooltip=""]
	ya [shape=box, label="id=ya\nmultiNoiseSampler_ridges", tooltip="delegate.id=yb\n"]
	yb -> ya [label="delegate"]
	yb [shape=diamond, label="id=yb\nauxName=\nmethod_445_RangeChoiceNode\nmethod_448_RangeChoiceNode\nRangeChoice [-0.15, 0.15)", tooltip="input.id=vr\ntrue.id=yc\nfalse.id=vr\n"]
	vr -> yb [label="input", color=blue]
	yc -> yb [label="true"]
	vr -> yb [label="false"]
	yc [shape=parallelogram, label="id=yc\nauxName=\nmethod_446_MulNode\nmul", tooltip="left.id=yd\nright.id=ye\n"]
	yd -> yc [label="left"]
	ye -> yc [label="right"]
	yd [shape=triangle, label="id=yd\n0.1", tooltip=""]
	ye [shape=diamond, label="id=ye\nauxName=\nmethod_447_RangeChoiceNode\nRangeChoice [-1000000.0, 0.0)", tooltip="input.id=vr\ntrue.id=yf\nfalse.id=yg\n"]
	vr -> ye [label="input", color=blue]
	yf -> ye [label="true"]
	yg -> ye [label="false"]
	yf [shape=triangle, label="id=yf\n-1.0", tooltip=""]
	yg [shape=triangle, label="id=yg\n1.0", tooltip=""]
}