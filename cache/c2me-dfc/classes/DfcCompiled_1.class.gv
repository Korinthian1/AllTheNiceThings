	bce [shape=parallelogram, label="id=bce\nauxName=\nmethod_550_MulNode\nmul", tooltip="left.id=bcf\nright.id=bcg\n"]
	bcf -> bce [label="left"]
	bcg -> bce [label="right"]
	bcf [shape=triangle, label="id=bcf\n0.1", tooltip=""]
	bcg [shape=diamond, label="id=bcg\nauxName=\nmethod_551_RangeChoiceNode\nRangeChoice [-1000000.0, 0.0)", tooltip="input.id=bby\ntrue.id=bch\nfalse.id=bci\n"]
	bby -> bcg [label="input", color=blue]
	bch -> bcg [label="true"]
	bci -> bcg [label="false"]
	bch [shape=triangle, label="id=bch\n-1.0", tooltip=""]
	bci [shape=triangle, label="id=bci\n1.0", tooltip=""]
}