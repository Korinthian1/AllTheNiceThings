	"chapters/refined_storage.snbt": {
		quest.0945EC53626F58E6.quest_desc: {
			new: ["On top of items and fluids, &3Refined Storage&r can also be used to store &aChemicals&r, thanks to the Refined Storage - Mekanism Integration mod.\\n\\nYou can also store &4Energy&r, &5Source&r and &9Souls&r, thanks to the Refined Types mod."]
			old: ["On top of items and fluids, &3Refined Storage&r can also be used to store &aChemicals&r, thanks to the Refined Storage - Mekanism Integration mod.\\n\\nYou can also store &4Energy&r and &5Source&r, thanks to the Refined Types mod."]
		}
	}
	"chapters/cataclysm.snbt": {
		quest.0B7F2B63D867D221.quest_desc: {
			new: ["To find these we'll need a little archeology! \\n\\nIn the giant shaft you'll take to get to the &e&lAncient Remnant&r, there are 3 rooms on the sides of it. \\n\\n2 of these rooms have Suspicious Sand which you can use a Brush on to get Loot! Including the &eNecklace of Desert&r. \\nThen, Right Click the &e&lAncient Remnant&r with the &eNecklace of Desert&r to resurrect it!"]
			old: ["To find these we'll need a little archeology! \\n\\nIn the giant shaft you'll take to get to the &e&lAncient Remnant&r, there are 3 rooms on the sides of it. \\n\\n2 of these rooms have Suspicious Sand which you can use a Brush on to get Loot! Including the &eNecklace of Desert&r. \\nThen, Right Click the &e&lAncient Remnant&r with the &eNecklace of Desert&r to resurect it!"]
		}
		quest.655FF7295B688354.quest_desc: {
			new: ["The &9Clawdian&r is the miniboss of &9Acropolis&r. \\n\\nThey are huge lobsters who hold an even bigger Axe! \\n\\nThey have 2250 &4Hearts&r and 12 Armor Points. \\n\\nThey like to use their Axe and Feet to Attack you. From swinging their Axe at you to do moderate Damage. To smashing the ground with an Axe to unleash a Shockwave. To stomping on the ground to unleash an even bigger Shockwave and &9Waves&r at you! \\n\\nIf you get too far they'll charge after you, Breaking Blocks in their way! \\n\\nIf you can Kill one, they'll Drop their &9Claw&r! Kinda graphic but thankfully it's just fantasy violence!"]
			old: ["The &9Clawdian&r is the miniboss of &9Acropolis&r. \\n\\nThey are huge lobsters who hold an even bigger Axe! \\n\\nThey have 225 &4Hearts&r and 12 Armor Points. \\n\\nThey like to use their Axe and Feet to Attack you. From swinging their Axe at you to do moderate Damage. To smashing the ground with an Axe to unleash a Shockwave. To stomping on the ground to unleash an even bigger Shockwave and &9Waves&r at you! \\n\\nIf you get too far they'll charge after you, Breaking Blocks in their way! \\n\\nIf you can Kill one, they'll Drop their &9Claw&r! Kinda graphic but thankfully it's just fantasy violence!"]
		}
		quest.1C5EA7D62BAF2108.quest_desc: {
			new: ["In order to fight &5&lThe Leviathan&r you'll need a sacrifice. The &5Abyssal Sacrifice&r to be specific. \\n\\nThe most basic Items needed is the Blocks of Ingots and Amethyst which are just &2&lVanilla&r Items. \\n\\nThen, you'll need a Nautilus Shell and a Heart of the Sea. These are &2&lVanilla&r Items which are rare to get... unless you kill &5Deeplings&r which can drop Nautilus Shells! Heart of the Sea still need to be found Exploring and Looting. \\n\\nYou'll also need an Athame which is a weapon used by &5Deepling Warlocks &fand &5Priests&r and dropped by them on death. \\nThe last part gives us a choice, either Crystallized Coral or Coral Chunk. Both are drops from &5Coral Golem&r and &5Coralssus&r."]
			old: ["In order to fight &5&lThe Leviathan&r you'll need a sacrifice. The &5Abyssal Sacrifice&r to be specific. \\n\\nThe most basic Items needed is the Blocks of Ingots and Amethyst which are just &2&lVanilla&r Items. \\n\\nThen, you'll need a Nautilus Shell and a Heart of the Sea. These are &2&lVanilla&r Items which are rare to get... unless you kill &5Deeplings&r which can drop them! \\n\\nYou'll also need an Athame which is a weapon used by &5Deepling Warlocks &fand &5Priests&r and dropped by them on death. \\nThe last part gives us a choice, either Crystallized Coral or Coral Chunk. Both are drops from &5Coral Golem&r and &5Coralssus&r."]
		}
		quest.0B7F2B63D867D221.quest_subtitle: {
			new: "Resurrecting an Ancient Remnant"
			old: "Resurecting an Ancient Remnant"
		}
		quest.33B1D3FD4C0B5514.quest_desc: {
			new: [
				"The &e&lAncient Remnant&r is master of his domain, of &eSand&r. \\n\\nHe has 2,700 &4Hearts&r and is aided with a &eWadjet&r and a &eKobolediator&r. \\n\\nHe has a few moves and attacks! He can swing his bony tail at you, bite you, or he might stomp on the ground, producing Shockwaves. \\n\\nHe can also summon &eSandstorms&r with a mighty ROAR and even drop &eSand Traps&r on your head. \\n\\nAnother attack he may use to get closer to you is his charge. His charge will hurt you and your FPS as it destroys every Block in his path. \\n\\nHe does have a weakness, the very thing that resurrected him! If you hit his &eNecklace&r he will be knocked down for a little bit, giving you the perfect chance to strike him down and return him to the grave!"
				"{image:atm:textures/questpics/cataclysm/cataclysm_remnant.png width:100 height:100 align:center}"
			]
			old: [
				"The &e&lAncient Remnant&r is master of his domain, of &eSand&r. \\n\\nHe has 2,700 &4Hearts&r and is aided with a &eWadjet&r and a &eKobolediator&r. \\n\\nHe has a few moves and attacks! He can swing his bony tail at you, bite you, or he might stomp on the ground, producing Shockwaves. \\n\\nHe can also summon &eSandstorms&r with a mighty ROAR and even drop &eSand Traps&r on your head. \\n\\nAnother attack he may use to get closer to you is his charge. His charge will hurt you and your FPS as it destroys every Block in his path. \\n\\nHe does have a weakness, the very thing that ressurected him! If you hit his &eNecklace&r he will be knocked down for a little bit, giving you the perfect chance to strike him down and return him to the grave!"
				"{image:atm:textures/questpics/cataclysm/cataclysm_remnant.png width:100 height:100 align:center}"
			]
		}
		quest.713006AB89E43C6D.quest_desc: {
			new: [
				"The tippy top of the massive &9Acropolis&r is where the &9&lScylla&r will spawn. Like the &d&lEnder Guardian&r you just need to be near to Spawn here. \\n\\nShe is one of the smallest Bosses in &4&lCataclsym&r only being around 3 Blocks Tall. As well as right now, she has 8658 &4Hearts&r and 12 Armor Points. Her buff was overdue, but was done.\\n\\nDon't let her Size let you underestimate her, she has some of the most Attacks of all Bosses here. \\n\\nShe can use her &9Anchor&r, &9Ceraunus&r, to pull you closer to her from far away, or simply swing it at you to deal a ton of Damage! \\n\\nShe can toss &9Lightning Spears&r at you from her Back or from Clouds. Even leaping into the Air and Jumping back down to bring &9Lightning Strikes&r all around where she Hit. \\n\\nThat's not even it! She also has control over &9Water&r allowing her to send &9Waves&r at you or even summon &9Water Snakes&r to Bite you! \\n\\nWhen slayed, she will Drop the usual Boss Gear, as well as &9Lacrima&r and &9Essence of the Storm&r."
				"{image:atm:textures/questpics/cataclysm/cataclysm_scylla.png width:100 height:100 align:center}"
			]
			old: [
				"The tippy top of the massive &9Acropolis&r is where the &9&lScylla&r will spawn. Like the &d&lEnder Guardian&r you just need to be near to Spawn here. \\n\\nShe is one of the smallest Bosses in &4&lCataclsym&r only being around 3 Blocks Tall. As well as right now, she has 390 &4Hearts&r and 12 Armor Points. Don't worry, she'll be Buffed very soon! \\n\\nDon't let her Size or lack of &6&lATM10&r Buffs let you underestimate her, she has some of the most Attacks of all Bosses here. \\n\\nShe can use her &9Anchor&r, &9Ceranus&r, to pull you closer to her from far away, or simply swing it at you to deal a ton of Damage! \\n\\nShe can toss &9Lightning Spears&r at you from her Back or from Clouds. Even leaping into the Air and Jumping back down to bring &9Lightning Strikes&r all around where she Hit. \\n\\nThat's not even it! She also has control over &9Water&r allowing her to send &9Waves&r at you or even summon &9Water Snakes&r to Bite you! \\n\\nWhen slayed, she will Drop the usual Boss Gear, as well as &9Lacrima&r and &9Essence of the Storm&r."
				"{image:atm:textures/questpics/cataclysm/cataclysm_scylla.png width:100 height:100 align:center}"
			]
		}
	}
	"chapters/apotheosis_gear.snbt": {
		quest.1D1FAA2F86695781.quest_desc: {
			new: ["For &l&2Frontier&r the Rarity of &eAffixes&r didn't matter, but now for &l&eAscent&r you'll need everything being &aUncommon&r or better. \\n\\nYou'll also need to kill an &4Invader&r aka an &6&lApothic&r Boss, to upgrade your &lWorld Tier&r. The Rarity of &4Boss&r doesn't matter! \\n\\n&eAffixes&r will only stay up to &5Epic&r but now &9Rare&r is more common than the rest. We can also get &6Mythic&r &aGems&r... just only with Lady Luck's Favor! \\n\\nSpeaking of Luck, our Luck will increase to 30%, Experience will jump to 55%, and &aMax Eterna&r will rise to &a60&r. \\n\\n&4Monsters&r in return will now have 8 Armor Points and 5 Armor Pierce."]
			old: ["For &l&2Frontier&r the Rarity of &eAffixes&r didn't matter, but now for &l&eAscent&r you'll need everything being &aUncommon&r or better. \\n\\nYou'll also need to kill an &4Invader&r aka an &6&lApothic&r Boss, to upgrade your &lWorld Tier&r. The Rarity of &4Boss&r doesn't matter! \\n\\n&eAffixes&r will only stay up to &5Epic&r but now &9Rare&r is more common than the rest. We can also get &6Mythic&r &aGems&r... just only with Lady Luck's Favor! \\n\\nSpeaking of Luck, our Luck will increase to 30% and Experience will jump to 55%. \\n\\n&4Monsters&r in return will now have 8 Armor Points and 5 Armor Pierce."]
		}
		quest.552BA5E6FA987256.quest_desc: {
			new: ["The &cSigil of Malice&r is a mysterious sigil. No one knows how to craft it. Rumors circulate about it being dropped by &4Invaders&r.\\n\\nWhen applied to &eAffix Gear&r in a &8&lSmithing Table&r, it overcharges a random &eAffix&r, but resets the power of another random &eAffix&r. An &6&lAugmenting Table&r can save the reset &eAffix&r."]
			old: ["The &cSigil of Malice&r is a mysterious sigil. No one knows how to craft it. Rumors circulate about it being dropped by &4Invaders&r.\\n\\nWhat it does is another mystery, though some players found that they lost an affix from gear they used it on, making a different affix stronger. The affixes chosen for this are, much like the sigil itself, yet another mystery."]
		}
		quest.2E5E129F25707C5D.quest_desc: {
			new: ["The &6Sigil of Supremacy&r!\\n\\nAnother sigil that cannot be crafted, similarly to &cMalice&r. Like &cMalice&r, it can overcharge &eAffixes&r. Unlike &cMalice&r, it does this to EVERY &eAffix&r on the gear, and will not reset any in the process, but has a lesser effect compared to &cMalice&r.\\n\\nYou can obtain this by beating 100 waves of the &zEndless Gateway of Apothic Invaders&r. "]
			old: ["The &6Sigil of Supremacy&r!\\n\\nAnother sigil that cannot be crafted, similarly to &cMalice&r. Like &cMalice&r, it can make affixes stronger. Unlike &cMalice&r, it does this to EVERY affix on the gear, and will not sacrifice any in the process.\\n\\nYou can obtain this by beating 100 waves of the &zEndless Gateway of Apothic Invaders&r. "]
		}
		quest.099C2A9B9CA138F8.quest_desc: {
			new: ["&6Mythics&r are some of the greatest we can get! \\n\\n&6Mythics&r are found only in &lWorld Tier: &6Summit&r and in &lWorld Tier: &4Pinnacle&r, where they are most common. \\n\\n&6Godforged Pearls&r are made from using &6Mythic&r &eItems&r in a &c&lSalvaging Table&r."]
			old: ["&6Mythic&r are some of the greatest we can get! \\n\\n&6Mythics&r are found only in &lWorld Tier: &6Summit&r and in &lWorld Tier: &4Pinnacle&r, where they are most common. \\n\\n&6Godforged Pearls&r are made from using &6Mythic&r &eItems&r in a &c&lSalvaging Table&r."]
		}
		quest.097FDC136BC843A7.quest_desc: {
			new: ["&lWorld Tier: &6Summit&r will need you to upgrade your &eArmor&r and &eTool/Weapon&r from &aUncommon&r to &9Rare&r (or better)! You'll also need to kill &0&lThe Wither&r. \\n\\n&0&lThe Wither&r doesn't need to be an &4Invader&r and honestly, it'll be easier if he isn't. \\n\\nIn &6&lSummit&r &5Epic&r &eItems &fand &2Gems&r will be the most common, and for &eItems&r you can now get &6Mythic&r and with &aGems&r you can find &zPerfect&r. Again, both being extremely rare! \\n\\nNow you'll get 75% Experience Gained, 50% Luck, and &a75 Max Eterna&r. \\n\\n&4Monsters&r will also be buffed to get 12 Armor Points, 10 Armor Toughness, 15 Armor Pierce, and 10 Protection Pierce. \\n\\nIs it just me or are their upgrades better than ours?"]
			old: ["&lWorld Tier: &6Summit&r will need you to upgrade your &eArmor&r and &eTool/Weapon&r from &aUncommon&r to &9Rare&r (or better)! You'll also need to kill &0&lThe Wither&r. \\n\\n&0&lThe Wither&r doesn't need to be an &4Invader&r and honestly, it'll be easier if he isn't. \\n\\nIn &6&lSummit&r &5Epic&r &eItems &fand &2Gems&r will be the most common, and for &eItems&r you can now get &6Mythic&r and with &aGems&r you can find &zPerfect&r. Again, both being extremely rare! \\n\\nNow we'll get 75% Experience Gained and 50% Luck. \\n\\n&4Monsters&r will also be buffed to get 12 Armor Points, 10 Armor Toughness, 15 Armor Pierce, and 10 Protection Pierce. \\n\\nIs it just me or are their upgrades better than ours?"]
		}
		quest.2A032EC573B5316C.quest_desc: {
			new: ["To get the &lWorld Tier: &2Frontier&r, you'll obviously need &9&lHaven&r done, but also need a few &eAffixed Items&r! \\n\\nHow many? You need a full set of &eAffixed Armor&r plus an &eAffixed Tool &for &eWeapon&r. \\n\\nNow &aUncommon&r &4Invaders &fand &aGems&r are most abundant, with the rest following in order: &8Common&r, &9Rare&r, and also &5Epic&r. \\n\\nThe Player with &lWorld Tier: &2Frontier&r will get a 35% Experience Boost, 20% Luck, and &a45 Max Eterna&r in total! \\n\\nHey, not everything will be easy though, now &4Monsters&r will gain 4 Armor Points extra."]
			old: ["To get the &lWorld Tier: &2Frontier&r, you'll obviously need &9&lHaven&r done, but also need a few &eAffixed Items&r! \\n\\nHow many? You need a full set of &eAffixed Armor&r plus an &eAffixed Tool &for &eWeapon&r. \\n\\nNow &aUncommon&r &4Invaders &fand &aGems&r are most abundant, with the rest following in order: &8Common&r, &9Rare&r, and also &5Epic&r. \\n\\nThe Player with &lWorld Tier: &2Frontier&r will get a 35% Experience Boost plus 20% Luck! \\n\\nHey, not everything will be easy though, now &4Monsters&r will gain 4 Armor Points extra."]
		}
		quest.7EF873DCEB3B9D48.quest_desc: {
			new: ["The last &lWorld Tier&r, &lWorld Tier: &4Pinnacle&r. To get it, you'll need to Kill the &d&lEnder Dragon&r atleast once, and equip all &5Epic&r or &6Mythic&r &eArmor &fand &eTool/Weapon&r. \\n\\nNow &5Epic&r and &6Mythic&r are most common for &aGems &fand &eTools&r, plus we are more likely to get &zPerfect&r gems! This comes at the loss of &8Common&r and &aUncommon&r but hey, who'll miss them! \\n\\nOn the same pattern of upgrades you'll get 125% Experience Gained and 100% Luck increase, and your &aMax Eterna&r reaches its highest point, &a100&r. \\n\\n&4Monsters&r will receive their final upgrade, getting: 16 Armor Points, 20 Armor Toughness, 25 Armor Pierce, and 20 Protection Pierce."]
			old: ["The last &lWorld Tier&r, &lWorld Tier: &4Pinnacle&r. To get it, you'll need to Kill the &d&lEnder Dragon&r atleast once, and equip all &5Epic&r or &6Mythic&r &eArmor &fand &eTool/Weapon&r. \\n\\nNow &5Epic&r and &6Mythic&r are most common for &aGems &fand &eTools&r, plus we are more likely to get &zPerfect&r gems! This comes at the loss of &8Common&r and &aUncommon&r but hey, who'll miss them! \\n\\nOn the same pattern of upgrades we'll get 125% Experience Gained and 100% Luck increase. \\n\\n&4Monsters&r will receive their final upgrade, getting: 16 Armor Points, 20 Armor Toughness, 25 Armor Pierce, and 20 Protection Pierce."]
		}
		quest.377A41499D8218C9.quest_desc: {
			new: ["The 1st &lWorld Tier&r is &l&9Haven&r! It being the first makes it the easiest to explore with and easiest to obtain. \\n\\nTo get it you just need to hold an &eAffixed Item&r in your Hand! It will automatically be set when unlocked. \\n\\nThe &lWorld Tier: &9Haven&r has highest chances for &8Common&r &aGear&r &fand &aGems&r. It can also have &aUncommon&r and very rarely, &9Rare&r.\\n\\nYour &aMax Eterna&r is also set to &a30&r on this &lWorld Tier&r.\\n\\nThis is also the only &lWorld Tier&r where &4Invaders&r cannot spawn naturally."]
			old: [
				"The 1st &lWorld Tier&r is &l&9Haven&r! It being the first makes it the easiest to explore with and easiest to obtain. \\n\\nTo get it you just need to hold an &eAffixed Item&r in your Hand! It will automatically be set when unlocked. \\n\\nThe &lWorld Tier: &9Haven&r has highest chances for &8Common&r &aGear&r &fand &aGems&r. It can also have &aUncommon&r and very rarely, &9Rare&r."
				""
				"This is also the only &lWorld Tier&r where &4Invaders&r cannot spawn naturally."
			]
		}
	}
	"chapters/hostile_neural_networks.snbt": {
		quest.104EBBC08B4733F5.quest_desc: {
			new: ["The &dSimulation Chamber&r is the main machine within HNN.\\n\\nWhen given power, it will run simulations based on the &bData Model&r that is placed inside. The power required also depends on the &bData Model&r placed inside, and can be seen within the &bModel&r's tooltip. \\n\\nThe machine also requires at least one &9Prediction Matrix&r to run a simulation.\\n\\nSimulations have two modes.\\n\\n&a&lTraining:&r\\nThe &bData Model&r gains data, without producing any &eGeneralized Predictions&r or &dMob Predictions&r. Costs more &cForge Energy&r compared to &2&lInference&r.\\n\\n&2&lInference:&r\\nThe result of the simulation will be output onto the Matrix, without the &bData Model&r gaining any Data.\\n\\nSimulations will always produce some kind of &eGeneralized Prediction&r, which can be used in various crafting recipes. They also vary depending on the origin of the mob in the Data Model.\\n\\nIf the simulation succeeds, you will receive a &dMob Prediction&r based off of the model. The higher the tier of the Data Model used, the higher the success rate is for a simulation.\\n\\nFaster compared to &a&lTraining&r."]
			old: ["The &dSimulation Chamber&r is the main machine within HNN.\\n\\nWhen given power, it will run simulations based on the &bData Model&r that is placed inside. The power required also depends on the Data Model placed inside, and can be seen within the Model's tooltip. \\n\\nThe machine also requires at least one &9Prediction Matrix&r to run a simulation.\\n\\nThe result of the simulation will be output onto the Matrix. Simulations will always produce some kind of &eGeneralized Prediction&r, which can be used in various crafting recipes. They also vary depending on the origin of the mob in the Data Model.\\n\\nIf the simulation succeeds, you will receive a &dMob Prediction&r based off of the model. The higher the tier of the Data Model used, the higher the success rate is for a simulation."]
		}
	}
