		}
		image.33BF690417B5AAF7.title: {
			new: "Join the Discord!"
			old: "Entre no Discord!"
		}
		quest.3BC0A50886A3222B.quest_desc: {
			new: ["ATM10 Aeronautics is a kitchensink pack that allows you to explore the world of modded Minecraft in your own way!\\n\\nIf you have any questions or issues, feel free to join the ATM discord!"]
			old: ["ATM10 is a kitchensink pack that allows you to explore the world of modded Minecraft in your own way!\\n\\nIf you have any questions or issues, feel free to join the ATM discord!"]
		}
	}
	"chapters/mahou_tsukai.snbt": {
		quest.565703CBB06CEABF.quest_desc: {
			new: ["I know why you are all here for; you're here for the &4&lMorgan Sword&r. \\n\\nIt is one of the powerful swords of all the &6&lATM Modpacks&r. \\n\\nFollow these Quests and you'll become an unstoppable force!"]
			old: ["I know why you all are here for, you're here for the &4&lMorgan Sword&r. \\n\\nOne of the powerful Swords of all the &6&lATM Modpacks&r. \\n\\nFollow these Quests and you'll become an unstoppable force!"]
		}
	}
	"chapters/undergarden.snbt": {
		quest.073BA8470EA37A00.quest_desc: {
			new: [
				"Another Sea, just this one is much colder."
				"{image:atm:textures/questpics/undergarden/undergarden_icy.png width:200 height:100 align:center}"
			]
			old: [
				"Another Sea, just this one is much colder."
				"{image:atm:textures/questpics/undergarden/undergarden_icey.png width:200 height:100 align:center}"
			]
		}
		quest.30582B5FBED35FD1.quest_desc: {
			new: ["&cUtheric Clusters&r and &cShards&r can be Dropped by multiple different Mobs, especially the &cRot&r Monsters. \\n\\n9 &cShards&r make 1 &cCluster&r. \\n\\nWe will then need to use an Infuser to combine &3Rogdorium&r and a &cUtheric Cluster&r to Craft &cUtheric Crystal&r."]
			old: ["&cUtherium&r can either be Mined or dropped from &cRot Mobs&r. "]
		}
		quest.53FDC6C536E50A1A.quest_desc: {
			new: ["&bGwiblings&r are friendly fish in the Seas. \\n\\nThey are smaller than &bGwibs&r and act like &2&lVanilla&r Fish!"]
			old: ["&bGwiblings&r are friendly fish in the Seas. \\n\\nThey are smaller than &bGwibs&r and act like Vanilla Fish!"]
		}
		quest.70FD8856BFCD9AEE.quest_desc: {
			new: [
				"The largest and most dangerous &cRot Mob&r. \\n\\nThey have 80 Hearts, which I think qualifies as a Boss. \\n\\nLike all &cRot Mobs&r they will target &2Stoneborns&r and &7Forgottens&r and will drop &cUtheric Shards&r."
				"{image:atm:textures/questpics/undergarden/undergarden_rotbeast.png width:100 height:100 align:center}"
			]
			old: [
				"The largest and most dangerous &cRot Mob&r. \\n\\nThey have 80 Hearts, which I think qualifies as a Miniboss. \\n\\nLike all &cRot Mobs&r they will target &2Stoneborns&r and &7Forgottens&r and will drop &cUtheric Shards&r."
				"{image:atm:textures/questpics/undergarden/undergarden_rotbeast.png width:100 height:100 align:center}"
			]
		}
		quest.51E2728C5E35A152.quest_desc: {
			new: ["Froststeel spawns in the Frozen Biomes: Frostfields, Frosty Smogstem Forests, and probably Icy Seas. \\n\\nIt spawns in Shiverstone which replaces Depthrock in these Biomes. The Shiverstone will act similar to Ice as in it is slippery and slows you down a little. \\n\\nYou might also find some Nuggets in Munchers bellies!"]
			old: ["Froststeel spawns in the Frozen Biomes: Frostfields, Frosty Smogstem Forests, and probably Icey Seas. \\n\\nIt spawns in Shiverstone which replaces Depthrock in these Biomes. The Shiverstone will act similar to Ice as in it is slippery and slows you down a little. \\n\\nYou might also find some Nuggets in Munchers bellies!"]
		}
		quest.744DBE831C120B2F.quest_desc: {
			new: [
				"Is that rock moving? Oh wait that isn't a rock, it's a &aMog&r! \\n\\n&aMogs&r can be bred together with Depthrock Pebbles and on death might drop more Pebbles or Mogmoss! \\n\\nMogmoss can be used in many different recipes!"
				"{image:atm:textures/questpics/undergarden/undergarden_mog.png width:100 height:100 align:center}"
			]
			old: [
				"Is that rock moving? Oh wait that isn't a rock, it's a &2Mog&r! \\n\\n&2Mogs&r can be bred together with Depthrock Pebbles and on death might drop more Pebbles or Mogmoss! \\n\\nMogmoss can be used in many different recipes!"
				"{image:atm:textures/questpics/undergarden/undergarden_mog.png width:100 height:100 align:center}"
			]
		}
		quest.4D836B9D9E3B898F.title: {
			new: "&aStoneborn&r"
			old: "&2Stoneborn&r"
		}
		quest.744DBE831C120B2F.title: {
			new: "&aMog&r"
			old: "&2Mog&r"
		}
		quest.4D836B9D9E3B898F.quest_desc: {
			new: [
				"&aStoneborns&r are the perfect mix of Villagers and Iron Golems. \\n\\nYou can trade with them by Right Clicking them. \\n\\nAnd they will fight off Hostile Mobs (or Players who hit them)."
				"{image:atm:textures/questpics/undergarden/undergarden_stoneborn.png width:100 height:150 align:center}"
			]
			old: [
				"&2Stoneborns&r are the perfect mix of Villagers and Iron Golems. \\n\\nYou can trade with them by Right Clicking them. \\n\\nAnd they will fight off Hostile Mobs (or Players who hit them)."
				"{image:atm:textures/questpics/undergarden/undergarden_stoneborn.png width:100 height:150 align:center}"
			]
		}
		quest.76CDC18D7A208512.quest_desc: {
			new: ["In The &2&lUndergarden&r, &cRot Mobs&r: &cRotling&f, &cRotwalker&f, &cRotbelcher&f, and the &cRotbeast&r can infect you with &cUtherium&r. \\n\\nIt will show up as Red Bars above your Hunger Bars if you catch it. After 4 full Bars red lines will appear on your screen. At 8 Bars the Bars will start shaking to warn you it's getting worse. At 10 Bars all of them will glow and this is when you start taking Damage. \\n\\n&cRot&r will slowly go away on its own unless it is full. You can also get Purity from Mysterious Totems or Eat &3Rogdorium&r to get rid of it. \\n\\nBoth of these come from the Depths, which Spawn below Y Level 0. You'll need a &aForgotten Pickaxe&r or another Pickaxe of the same Tier like &6Allthemodium&r to reach it. \\n\\nThe only way to prevent the &cRot&r is by Infusing your Armor with &3Rogdorium&r using the Infuser."]
			old: ["In The &2&lUndergarden&r, &cRot Mobs&r can infect you with &cUtherium&r. In lower doses, this infection will decay over time. In high enough doses, it won't decay, and will have to be cured with &3Rogdorium&r, which is only found deep in the Dreadrock regions. You can either consume it, or infuse your armor with it to ward off this infection. I'll even give you some &3Rogdorium&r on the house!"]
		}
		quest.17C2C8F64B4AE6EE.quest_desc: {
			new: [
				"&2Dwellers&r are the Cows of &2&lUndergarden&r. \\n\\nThey are Passive and will drop Leather and Dweller Meat on death. \\n\\nThank God they can't be milked, I don't want any milk these &2Dwellers&r make."
				"{image:atm:textures/questpics/undergarden/undergarden_dweller.png width:100 height:100 align:center}"
			]
			old: [
				"&2Dwellers&r are the Cows of &2&lUndergarden&r. \\nThey are Passive and will drop Leather and Dweller Meat on death. \\n\\nThank God they can't be milked, I don't want any milk these &2Dwellers&r make."
				"{image:atm:textures/questpics/undergarden/undergarden_dweller.png width:100 height:100 align:center}"
			]
		}
	}
	"chapters/allthemodium.snbt": {
		quest.5BA986D7928BF09F.quest_desc: {
			new: ["The Piglich is a Boss added by &6&lAllthemodium&r. \\n\\nHe has 9999 Hearts and currently has no attacks but trust me when he does they will be devastating! \\n\\nWhen killed he'll drop his Heart which will be needed for Alloys and the ATM Star! \\n\\n(Look into ways of farming them like with HNN or EnderIO!)"]
			old: ["The Piglich is a Boss added by &6&lAllthemodium&r. \\n\\nHas he 1000 Hearts and currently has no attacks but trust me when he does they will be devastating! \\n\\nWhen killed he'll drop his Heart which will be needed for Alloys and the ATM Star! \\n\\n(Look into ways of farming them like with HNN or EnderIO!)"]
		}
	}
	"chapters/pylons.snbt": {
		quest.18246A48C20B29D8.quest_desc: {
			new: ["The Infusion Pylon works similar as a Beacon just much better and cheaper! \\nWhen a Potion Effect is put in by a Potion Filter, it will continuously give you the Potion Effect while you're in the set Chunk area."]
			old: ["The Infusion Pylon works similar as a Beacon just much better and cheaper! \\nWhen a Potion Effect is put in by a Potion Filter, it will continuously give you the Potion Effect no matter where you are! \\n\\nYou heard me right, no longer is there a set radius for the Infusion Pylon, now it will reach you wherever."]
		}
		quest.011F787E620DE9E8.quest_desc: {
			new: ["To set the Mob Filter you just have to click the Mob you never want to see again, or prevent accidentally killing, with the Mob Filter. \\n\\nEach Filter can only hold 1 Mob so if you want Zombies, Skeletons, Spiders, Creepers, and Endermen to no longer spawn you'll need 5 Mob Filters. \\n\\nYou can exchange the Mob in it by simplying clicking a different Mob with it."]
			old: ["To set the Mob Filter you just have to click the Mob you never want to see again, with the Mob Filter. \\n\\nEach Filter can only hold 1 Mob so if you want Zombies, Skeletons, Spiders, Creepers, and Endermen to no longer spawn you'll need 5 Mob Filters. \\n\\nYou can exchange the Mob in it by simplying clicking a different Mob with it."]
		}
		quest.12ED1EE85E146A4B.quest_desc: {
			new: ["Harvester Pylons work as a very simple Auto-Farm. Put the Pylon on or in the Water Source and it will automatically harvest and replant Crops that are fully grown in the set area around it. \\n\\nThe area can be set to 3x3, 5x5, 7x7, or 9x9 Blocks around the Pylon. \\n\\nIt will need a Hoe to use on the Plants and will need an Inventory like a chest above it to put the Crops. Do all that and if it's turned On it will start farming!\\n\\n(Careful when using a lot of modifiers with it like Lilypads or fertilizer as when it goes very fast farming it can be a TPS eater)."]
			old: [
				"Harvester Pylons work as a very simple Auto-Farm. Put the Pylon on or in the Water Source and it will automatically harvest and replant Crops that are fully grown in the set area around it. "
				""
				"The area can be set to 3x3, 5x5, 7x7, or 9x9 Blocks around the Pylon. "
				""
				"It will need a Hoe to use on the Plants and will need an Inventory like a chest above it to put the Crops. Do all that and if it's turned On it will start farming!"
			]
		}
		quest.5B5FC539BD1F4A73.quest_desc: {
			new: ["This Pylon is all about blocking Mob Spawns. \\n\\nYou can use Mob Filters to block spawns of only certain Mobs or use the Lifeless Filter to block all Mob spawns! \\n\\nYou can stack multiple Mob Filters to block off more spawns. Plus you can change the Working Area for how far it blocks those Mob Spawns. \\n\\nIf you use the Lifeless Filter it will ignore all those settings."]
			old: [
				"This Pylon is all about blocking Mob Spawns. "
				""
				"You can use Mob Filters to block spawns of only certain Mobs or use the Lifeless Filter to block all Mob spawns! "
				""
				"You can stack multiple Mob Filters to block off more spawns. Plus you can change the Working Area for how far it blocks those Mob Spawns. "
				""
				"If you use the Lifeless Filter it will ignore all those settings."
			]
		}
		quest.5C2C29ECA67F9B49.quest_desc: {
			new: ["With the Lifeless Filter you will never have to worry about any Mob spawns within a 25x25 Block area. \\n\\nThat's enough to cover every distance Mobs spawn near the player. Hostile or Passive. \\n\\nThis includes every Y Level as well, above or below the Pylon, so no more worrying about lighting up caves! \\n\\nThere's no Whitelisting with this Filter, it will prevent every Mob Spawn."]
			old: [
				"With the Lifeless Filter you will never have to worry about any Mob spawns within a 25x25 Chunk area. "
				""
				"This doesn't include Forced Spawns though, that is Mobs spawned from Spawners or even Spawn Eggs!"
				""
				"The 25x25 will cover every distance Mobs spawn near the player. Hostile or Passive. "
				""
				"This includes every Y Level as well, above or below the Pylon, so no more worrying about lighting up caves! "
				""
				"There's no Whitelisting with this Filter, it will prevent every Mob Spawn."
			]
		}
	}
	"chapters/bounty_board.snbt": {
		quest.3813F5C1760C3A79.quest_desc: {
			new: ["Piglin Brutes being here might cause controversy but I consider them Minibosses. \\n\\nThey spawn in Bastions with regular Piglins but these are Hostile not Neutral. Personally I hate that, especially since if you hit them all Piglins will turn Hostile on you. \\n\\nThey have 50 Hearts and a Golden Axe to hit you. Usually Golden Axes barely do any damage, but when they use it, it is god tier somehow! \\n\\nThey drop nothing and act more like an obstacle for Bastions!"]
			old: ["Piglin Brutes being here might cause controversey but I consider them Minibosses. \\n\\nThey spawn in Bastions with regular Piglins but these are Hostile not Neutral. Personally I hate that, especially since if you hit them all Piglins will turn Hostile on you. \\n\\nThey have 50 Hearts and a Golden Axe to hit you. Usually Golden Axes barely do any damage, but when they use it, it is god somehow! \\n\\nThey drop nothing and act more like an obstacle for Bastions!"]
		}
	}
	"chapters/building_tips.snbt": {
		quest.72DB967E59EEA729.quest_desc: {
			new: ["&e&lExcessive Utilities&r offers a bunch of different Glass variants! \\n\\nIt's not just normal Glass, some of these have abilities which can be read by pressing ALT while hovering over the Item! \\n\\nLike Ethereal Glass (Inverted) which you can walk through but Mobs can't. (I used that for my Bee Dome in 9sky!)"]
			old: ["&3&lGlassential&r is very important Mod for building, even for builds with purposes! \\nIt's not just normal Glass, these have abilities which can be read while hovering over the Item! \\n\\nLike Ethereal Glass which you can walk through but Mobs can't. (I used that for my Bee Dome in 9sky!)"]
		}
		task.53A682560123F9B6.title: {
			new: "Excessive Utilities Glass"
			old: "Glassential"
		}
		quest.22D2CFDDB06C720C.quest_desc: {
			new: ["Tools are very important in &2&lMinecraft&r but so is inventory space. So why not clear some space up by making a Paxel! \\nPaxels are a combination of Pickaxes (P), Axes (axe), and Shovels (els). \\n\\nThey can strip wood, make paths, and mine any blocks a pickaxe/axe/shovel of its tier can!"]
			old: ["Tools are very important in &2&lMinecraft&r but so is inventory space. So why not clear some space up by making a Paxel! \\nPaxels are a combination of Pickaxes (P), Axes (axe), and Shovels (els). \\n\\nThey can strip wood, make paths, and mine any blocks that same pickaxe/axe/shovel tier can!"]
		}
		quest.027E6E294D9E1375.quest_desc: {
			new: ["Take notes &lCorail&r! This is how you do Holidays! (I say this with 100% love, we love you &lCorail&r!) \\n\\nThis addition adds plenty of decorations for Christmas and Halloween. \\n\\nFrom Christmas Trees, Presents, and Lights for Christmas to Pumpkins, Spiders, and Witch Hats for Halloween."]
			old: ["Take notes &lCorail&r! This is how you do Holidays! (I say this will 100% love, we love you &lCorail&r!) \\n\\nThis addition adds plenty of decorations for Christmas and Halloween. \\n\\nFrom Christmas Trees, Presents, and Lights for Christmas to Pumpkins, Spiders, and Witch Hats for Halloween."]
		}
		quest.72DB967E59EEA729.title: {
			new: "&e&lExcessive Utilities&r Glass"
			old: "&3&lGlassential&r"
		}
	}
	"chapters/occultism.snbt": {
		quest.690B89D23134B624.quest_desc: {
			new: [
				"Grab your chalks, draw your &dRonaza's Contact&r ritual, and get ready to create the ULTIMATE CHALK!"
				""
				"Instead of having to lug around a full set of 16 chalks, you can use the Rainbow Chalk to paint a color-changing Rune that counts as any of them!"
			]
			old: [
				"Grab your chalks, draw your &dRonaza's Contact&r ritual, and get ready to create the ULTIMATE CHALK*!"
				""
				"Instead of having to lug around a full set of 16 chalks, you can use the Rainbow Chalk to paint a color-changing Rune that counts as any of them!"
				""
				"&8*Does not include Foundation Chalk. Make the Void Chalk to include those&r"
			]
		}
		quest.54378277B8D28B1D.quest_desc: {
			new: ["An alternative to the Rainbow Chalk, for those who prefer the colors of Foundation Chalk.\\n\\nHas the same function as the Rainbow Chalk, except all the runes will cycle between Foundation Chalk colors."]
			old: [
				"An \"upgrade\" to the Rainbow Chalk, for those who don't like the rapid color-switching runes ruining their tediously crafted aesthetic. "
				""
				"Has the same function as the Rainbow Chalk, except all the runes will show up as white. Additionally, it works for foundation chalk as well."
			]
		}
	}
	"chapters/apothic_enchanting.snbt": {
		quest.001A348054127235.quest_desc: {
			new: ["&5Budding Amethyst&r can be useful for Crafting Recipes and even just Growing &5Amethyst&r! \\n\\nWith a &5Amethyst Block&r, &a60 Eterna&r, between &c30% &fand &c50% Quanta&r, and &550% Arcana&r we can &d&lInfuse&r one. \\n\\nTo get all those stats we can use 10 &9Deepshelves&r (not &9Dormant&r ones), 2 &2Melonshelves&r, and 7 &7Basic Bookshelves&r.\\n\\nOr, if you chose &bSeashelves&r, you can use 11 &bCrystalline Seashelves&r and 1 &bInfused Seashelf&r."]
			old: ["&5Budding Amethyst&r can be useful for Crafting Recipes and even just Growing &5Amethyst&r! \\n\\nWith a &5Amethyst Block&r, &a60 Eterna&r, between &c30% &fand &c50% Quanta&r, and &550% Arcana&r we can &d&lInfuse&r one. \\n\\nTo get all those stats we can use 15 &4Glowing Hellshelves&r and 4 &2Melonshelves&r."]
		}
		quest.377D6CF86BC1C64F.quest_desc: {
			new: ["The &8Tome of Scrapping&r will only take off half the &5Enchantments&r, while the &8Tome of Superior Scrapping&r will take every &5Enchantment&r off the Item! \\n\\nBoth of these &8Tomes&r will break the Item in use though. \\n\\nTo &d&lInfuse&r our &8Tome of Scrapping&r into a &8Tome of Superior Scrapping&r you can use 3 &9Echoing Sculkshelves&r and 15 &7Basic Bookshelves&r.\\n\\nOr, if you want this &8Tome&r on &2&lFrontier&r, you can use 8 &bCrystalline Seashelves&r."]
			old: ["The &8Tome of Scrapping&r will only take off half the &5Enchantments&r, while the &8Tome of Superior Scrapping&r will take every &5Enchantment&r off the Item! \\n\\nBoth of these &8Tomes&r will break the Item in use though. \\n\\nTo &d&lInfuse&r our &8Tome of Scrapping&r into a &8Tome of Superior Scrapping&r we can use 3 &9Echoing Sculkshelves&r and 15 Bookshelves, or 4 Draconium Blocks."]
		}
		quest.784466C3813AA506.quest_desc: {
			new: ["Ever wanted to pick up mobs? We...have Soul Gems and Creature Catchers for that.\\n\\nLet's just ignore those for now and focus on the option &5&lApotheosis&r offers. The &5Flimsy Ender Lead&r is the cheapest variant of &5Ender Lead&r, but also the weakest, and most fragile. It can only hold animals, and breaks after 8 uses."]
			old: ["Ever wanted to pick up mobs? We...have Soul Gems, Mob Imprisonment Tools, and Creature Catchers for that.\\n\\nLet's just ignore those for now and focus on the option &5&lApotheosis&r offers. The &5Flimsy Ender Lead&r is the cheapest variant of &5Ender Lead&r, but also the weakest, and most fragile. It can only hold animals, and breaks after 8 uses."]
		}
		quest.79AF63E77AD70A93.quest_desc: {
			new: ["&7Basic Bookshelves&r are your starting point, but definitely not your end point. Atleast not &7Basic Bookshelves&r. \\n\\nWith only &7Basic Bookshelves&r you can only get &aEterna&r up and to a max of 30. \\n(I will explain the &5Enchantment Levels&r soon but just know you need them up)\\n\\n(&7Basic Bookshelves&r and vanilla &7Bookshelves&r are interchangeable)"]
			old: ["&7Bookshelves&r are your starting point, but definitely not your end point. Atleast not normal &7Bookshelves&r. \\n\\nWith only normal &7Bookshelves&r you can only get &aEterna&r up and to a max of 30. \\n(I will explain the &5Enchantment Levels&r soon but just know you need them up)"]
		}
		quest.3D31B94CC42BCE43.quest_desc: {
			new: ["The &8Tome of Extraction&r is the &8Tome&r we are looking for! It will take off all &5Enchantments&r and leave the Item alone!\\n\\nTo make it we'll need to &d&lInfuse&r our &8Tome of Superior Scrapping&r. \\n\\nWe can just use our previous &9Sculkshelf&r setup for this."]
			old: ["The &8Tome of Extraction&r is the &8Tome&r we are looking for! It will take off all &5Enchantments&r and leave the Item alone! \\n\\nTo make it we'll need to &d&lInfuse&r our &8Tome of Superior Scrapping&r. \\n\\nWe can just use our previous setup for this."]
		}
		quest.235E3C386E8D36A3.quest_desc: {
			new: [
				"This is where the seperation of &4Hellshelves&r and &bSeashelves&r end! \\n\\nFirst, we'll need to Craft a &9Dormant Deepshelf&r. These are just 6 &8Cracked Deepslate Tiles&r and 3 &7Books&r. \\n\\nThen, we'll need &a60 Eterna&r, &c40% Quanta&r, and &540% Arcana&r. We can get that with 12 &bCrystalline Seashelves&r or 13 &4Glowing Hellshelves&r! \\n\\nFinally, we can &d&lInfuse&r our &9Dormant Deepshelves&r into regular &9Deepshelves&r!"
				"{image:atm:textures/questpics/apothic/enchant_deepshelf.png width:100 height:100 align:center}"
			]
			old: [
				"This is where the seperation of &4Hellshelves&r and &bSeashelves&r end! \\n\\nFirst, we'll need to Craft a &9Dormant Deepshelf&r. These are just 6 &8Cracked Deepslate Tiles&r and 3 &7Books&r. \\n\\nThen, we'll need &a60 Eterna&r, &c40% Quanta&r, and &540% Arcana&r. We can get that with 12 &bCrystalline Seashelves&r or 12 &4Glowing Hellshelves&r! \\n\\nFinally, we can &d&lInfuse&r our &9Dormant Deepshelves&r into regular &9Deepshelves&r!"
				"{image:atm:textures/questpics/apothic/enchant_deepshelf.png width:100 height:100 align:center}"
			]
		}
		quest.61217D80BFF8A858.quest_desc: {
			new: ["The third and final tier of &5Ender Lead&r is here! This one is unbreakable and can even bind mobs to Spawners. It will require a considerably more tricky &d&lInfusion&r setup. We'll need at least &a75 Eterna&r, &c85% Quanta&r, and between &560-85% Arcana&r.\\n\\nYou can get this with 4 &9Soul-Touched Sculkshelves&r, 4 &9Echoing Sculkshelves&r, 3 &7Stoneshelves&r, and 2 &7Basic Bookshelves&r. Oh, and you also need a Witch in the Ender Lead used for this &d&lInfusion&r."]
			old: ["The third and final tier of &5Ender Lead&r is here! This one is unbreakable and can even bind mobs to Spawners. It will require a considerably more tricky &d&lInfusion&r setup. We'll need at least &a75 Eterna&r, &c85% Quanta&r, and between &560-85% Arcana&r.\\n\\nYou can get this with 4 &9Soul-Touched Sculkshelves&r, 4 &9Echoing Sculkshelves&r, 3 &7Stoneshelves&r, and 2 vanilla Bookshelves. Oh, and you also need a Witch in the Ender Lead used for this &d&lInfusion&r."]
		}
		quest.0F3A0A4DC18E5E55.quest_desc: {
			new: ["&aEterna&r sets the &5Enchantment Level&r which determines what &5Enchantments&r you can or will get! \\n\\nIt's default is &a0&r and max is determined by your &lWorld Tier&r.\\n\\n&a30&r on &9&lHaven&r.\\n&a45&r on &2&lFrontier&r.\\n&a60&r on &e&lAscent&r.\\n&a75&r on &6&lSummit&r.\\n&a100&r on &4&lPinnacle&r.\\n\\nCheck out the Apotheosis Gear chapter or the linked quests in this chapter to learn more about &lWorld Tiers&r!\\n\\nAlmost all &7Bookshelves&r will give &aEterna&r but each has max they can set it to."]
			old: ["&aEterna&r sets the &5Enchantment Level&r which determines what &5Enchantments&r you can or will get! \\n\\nIt's default is &a0&r and max is &a100&r. \\n\\nAlmost all &7Bookshelves&r will give &aEterna&r but each has max they can set it to."]
		}
		quest.78BFDD3A9B996655.quest_desc: {
			new: ["A considerable step up from the &5Flimsy Ender Lead&r. Now, it can hold hostile mobs as well, and will break after 64 uses. To get this, we will need at least &a45 Eterna&r, &c25% Quanta&r, and &540% Arcana&r.\\n\\nThis can be achieved with 9 &bCrystalline Seashelves&r, or, if you chose &4Hellshelves&r, 9 &4Glowing Hellshelves&r and 8 Candles (Tip: You can fit up to 4 candles into one block)"]
			old: ["A considerable step up from the &5Flimsy Ender Lead&r. Now, it can hold hostile mobs as well, and will break after 64 uses. To get this, we will need at least &a45 Eterna&r, &c25% Quanta&r, and &540% Arcana&r.\\n\\nThis can be achieved with 9 &bCrystalline Seashelves&r, or, if you prefer &4Hellshelves&r, 9 &4Glowing Hellshelves&r and 8 Candles (Tip: You can fit up to 4 candles into one block)"]
		}
		quest.24C757B8AA6841F6.quest_desc: {
			new: ["&5&lApotheosis&r knows how annoying &3Tridents&r can be to get so they made it easier... well kinda easier! \\n\\nYou can now make an &3Inert Trident&r and &d&lInfuse&r it to get a normal &3Trident&r. \\n\\nThe &3Trident&r requires between &a40 Eterna&r, &c20%-50% Quanta&r, and atleast &535% Arcana&r. \\n\\nYou can get this with 5 &7Basic Bookshelves&r and 3 &9Echoing Sculkshelves&r.\\n\\nOr, if you really want a &3Trident&r on &2&lFrontier&r, you can also get this with 2 &bCrystalline Seashelves&r and 4 &bInfused Seashelves&r."]
			old: ["&5&lApotheosis&r knows how annoying &3Tridents&r can be to get so they made it easier... well kinda easier! \\n\\nYou can now make an &3Inert Trident&r and &d&lInfuse&r it to get a normal &3Trident&r. \\n\\nThe &3Trident&r requires between &a40 Eterna&r, &c20%-50% Quanta&r, and atleast &535% Arcana&r. \\n\\nYou can get this with 1 &7Bookshelf&r, 4 &9Echoing Sculkshelf&r, and 1 &2Melonshelf&r."]
		}
		quest.45161821C221EF0B.quest_desc: {
			new: ["Once we get those 15 &4Hellshelves&r around our &5Enchantment Table&r, we'll have &a45 Eterna&r and &c30% Quanta&r in our &5Table&r. \\n\\nThis is the perfect amount to &d&lInfuse&r our &4Hellshelves&r! \\n\\n&4Infused Hellshelves&r give &a5 Eterna&r with a max of &a60 Eterna&r, along with &c5% Quanta&r. \\n\\nThese can be Crafted with other Items to make different &7Bookshelves&r, for the ones we want we'll need 13 &4Infused Hellshelves&r! \\n\\nOf course, with me being soooo generous, you'll only need to collect 8!"]
			old: ["Once we get those 15 &4Hellshelves&r around our &5Enchantment Table&r, we'll have &a45 Eterna&r and &c30% Quanta&r in our &5Table&r. \\n\\nThis is the perfect amount to &d&lInfuse&r our &4Hellshelves&r! \\n\\n&4Infused Hellshelves&r give &a5 Eterna&r with a max of &a60 Eterna&r, along with &c5% Quanta&r. \\n\\nThese can be Crafted with other Items to make different &7Bookshelves&r, for the ones we want we'll need 12 &4Infused Hellshelves&r! \\n\\nOf course, with me being soooo generous, you'll only need to collect 8!"]
		}
		quest.7C758209D06ED0E3.quest_desc: {
			new: ["By combining an &4Infused Hellshelf&r with some &eGlowstone&r we can make &4Glowing Hellshelves&r! \\n\\nThese have the same &aEterna&r and &cQuanta&r, but give &53.3333% Arcana&r. \\n\\nThis will be helpful in later &d&lInfusions&r, like if we wish to use 13 of them to &d&lInfuse&r a &9Dormant Deepshelf&f into a &9Deepshelf&r!"]
			old: ["By combining an &4Infused Hellshelf&r with some &eGlowstone&r we can make &4Glowing Hellshelves&r! \\n\\nThese have the same &aEterna&r and &cQuanta&r, but give &53% Arcana&r. \\n\\nThis will be helpful in later &d&lInfusions&r, like if we wish to use 12 of them to &d&lInfuse&r a &9Dormant Deepshelf&f into a &9Deepshelf&r!"]
		}
		quest.78E66F1DE42C747A.quest_desc: {
			new: ["&9Echo Shards&r can be pretty annoying to farm, plus we'll need a lot of them! So why not have an easier way of Farming them. \\n\\nWith &d&lInfusion&r we can make 1 &9Echo Shard&r into 4! \\n\\nWe'll need &a70 Eterna&r, &c50% Quanta&r, and &550% Arcana&r. \\n\\nTo get that, we can use either of the following:\\n\\n14 &9Deepshelves&r, that aren't &9Dormant&r!\\n13 &4Glowing Hellshelves&r and 2 &9Deepshelves&r!\\n12 &bCrystalline Seashelves&r and 2 &9Deepshelves&r!"]
			old: ["&9Echo Shards&r can be pretty annoying to farm, plus we'll need a lot of them! So why not have an easier way of Farming them. \\n\\nWith &d&lInfusion&r we can make 1 &9Echo Shard&r into 4! \\n\\nWe'll need &a70 Eterna&r, &c50% Quanta&r, and &550% Arcana&r. \\n\\nTo get that, we can use 12 &4Glowing Hellshelves&r and 2 &9Deepshelves&r, that aren't &9Dormant&r!"]
		}
	}
	"chapters/applied_energistics_2.snbt": {
		quest.79D2617E01481281.quest_desc: {
			new: ["To get started with AE2, you will need to mine an important resource for the mod known as &bCertus Quartz&f. You will find Certus Quartz Crystals in Meteorites that you can mine for Certus Quartz &eDust&f and &eCrystals&f."]
			old: ["To get started with AE2, you will need to mine an important resource for the mod known as &bCertus Quartz&f. You will find Certus Quartz Crystals in Meteroites that you can mine for Certus Quartz &eDust&f and &eCrystals&f."]
		}
		quest.51236544BFEF487B.quest_desc: {
			new: ["It is time to find &eMeteorites&r that contain &bSky Stone&r. They are found buried underground, typically near the surface, and contain a &bMysterious Cube&f in its center.\\n\\nThis cube contains all of the different &ePresses&r used in the Inscriber to make AE2's special crafting components.\\n\\nThe easiest way to locate a meteorite is by crafting a &eMeteorite Compass&r by placing a compass inside of a Charger."]
			old: ["It is time to find &eMeteorites&f that contain &bSky Stone&f. These can be either on the surface or underground, and contain a &bMysterious Cube&f in its center.\\n\\nThis cube contains all of the different &ePresses&f used in the Inscriber to make AE2's special crafting components.\\n\\nThe easiest way to locate a meteorite is by crafting a &eMeteorite Compass&r by placing a compass inside of a Charger."]
		}
		quest.1710B3D05215A71E.quest_desc: {
			new: [
				"&bP2P&f (point-to-point) is a powerful system within AE2, allowing for the transfer of items, fluids and even more without the need for any intermediary ME storage. "
				""
				"Right-clicking on a P2P tunnel with certain items will &eattune&f the tunnel into one capable of transferring something else, such as items through pipes, energy through cables, redstone signals and (by default) even ME connections themselves. "
				""
				"P2P tunnels must be linked to one another with the use of a &eMemory Card&f, detailed in the next quest."
			]
			old: [
				"&bP2P&f (peer-to-peer) is a powerful system within AE2, allowing for the transfer of items, fluids and even more without the need for any intermediary ME storage. "
				""
				"Right-clicking on a P2P tunnel with certain items will &eattune&f the tunnel into one capable of transferring something else, such as items through pipes, energy through cables, redstone signals and (by default) even ME connections themselves. "
				""
				"P2P tunnels must be linked to one another with the use of a &eMemory Card&f, detailed in the next quest."
			]
		}
	}
	"chapters/chapter_2_the_star.snbt": {
		quest.263C9A0FC04472AB.title: {
			new: "&6Heated Redstone Generator"
			old: "&464x Magmatic Generator"
		}
		quest.59EC02C1FBCF14EA.quest_desc: {
			new: ["&3Ender Quarry Fortune III Upgrade&r applies the Fortune III enchantment to the &3Ender Quarry&r."]
			old: ["You can upgrade your &5Obsidian Generator&r into an &3Ender Generator&r. \\n\\nThen, it can use &3Ender Pearls&r or &3Eyes of Ender&r to make Energy! \\n\\nOr make the &6&lStar&r, your choice."]
		}
		quest.76C63670624C3C56.title: {
			new: "&e&lExcessive Utilities"
			old: "&c&lGenerator Galore"
		}
		quest.2D64EF8D803AF9DA.quest_desc: {
			new: ["The most expensive Portal we can make. First for &dDragon Eggs&r you don't have to keep milking the &dDragon&r you can use &l&bHNN&r or &l&2MA&r to get them or an Extractor to make more! \\n\\nThen, you'll need &dInfused Dragon's Breath&r from Enchanting. \\n\\nThere you'll need &9Soul-Touched Sculkshelves&r to Enchant it and to make the Portal. \\n\\nIf you are wondering why the Portal won't work, it's because you are already in the &2&lOverworld&r! Just kidding you can't use it!"]
			old: ["The most expensive Portal we can make. First for &dDragon Eggs&r you don't have to keep milking the &dDragon&r you can use &l&bHNN&r or &l&2MA&r to get them or an Extrator to make more! \\n\\nThen, you'll need &dInfused Dragon's Breath&r from Enchanting. \\n\\nThere you'll need &9Soul-Touched Sculkshelves&r to Enchant it and to make the Portal. \\n\\nIf you are wondering why the Portal won't work, it's because you are already in the &2&lOverworld&r! Just kidding you can't use it!"]
		}
		quest.5869E198DA416346.quest_desc: {
			new: ["The embodiment of a perfect opinion.\\n\\nA single Perfected Opinium Core requires:\\n- 1024 Red Coal\\n- 4609 Iron Ingots\\n- 2304 Gold Ingots\\n- 1152 Diamonds\\n- 576 Emeralds\\n- 32 Chorus Flowers\\n- 16 Bottles o' Enchanting\\n- 8 Elytras\\n- 4 Nether Stars\\n\\nIn my opinion, a better choice for the &3&lImprobable Probability Device&r than &5Antimatter&r."]
			old: ["Late Game &5&lMekanism&r is just insane. For 1 &5Antimatter Pellet&r you need to crystallize 1,000mb &5Antimatter&r. \\n\\nFor 1mb of &5Antimatter&r you need to power 1,000mb of &3Polonium&r through the SPS. \\n\\nTo get 1mb of &3Polonium&r you'll need to activate the Neutrons of 5mb of &2Nuclear Waste&r. \\n\\nAnd &2Nuclear Waste&r you get from processing &9Fissile Fuel&r through a Fission Reactor!"]
		}
		quest.59EC02C1FBCF14EA.title: {
			new: "&3Ender Quarry Fortune III Upgrade"
			old: "&3Ender Generator"
		}
		quest.263C9A0FC04472AB.quest_desc: {
			new: ["This one can either eat &cLava&r and &4Redstone&r like no other, or be used for the &6&lStar&r. \\n\\nThis one's a hard one, I like seeing &cLava&r disappear instead of my stuff disappearing into &cLava&r."]
			old: ["This one can either eat &cLava&r like no other, or be used for the &6&lStar&r. \\n\\nThis one's a hard one, I like seeing &cLava&r disappear instead of my stuff disappearing into &cLava&r."]
		}
		quest.5869E198DA416346.title: {
			new: "2 Perfected Opinium Cores"
			old: "2 &5Antimatter Pellets"
		}
		quest.4CB488E5CF10F3A4.quest_desc: {
			new: ["Only the most powerful and expensive Generator from &e&lExcessive Utilities&r. \\n\\nYou'll need one of every Generator in the mod!"]
			old: ["Only the most powerful and expensive Generator from &c&lGenerator Galore&r. \\n\\nYou'll need an &9Echo Shard&r, a &bConduit&r, and a ton of Netherstar Generators!"]
		}
		quest.752DD0BF36B70D88.quest_desc: {
			new: ["Furnaces just aren't fast enough in normal &2&lMinecraft&r, so how do you think they're going to fair in Modded!?\\n\\nThankfully &7&lIron Furnaces&r helps speed them up by a lot! \\n\\nIt also has a Quest page."]
			old: ["Furnaces just aren't fast enough in normal &2&lMinecraft&r, so how do you think they're going to fair in Modded!?\\n\\nThankfully &7&lIron Furnaces&r helps speed them up by a lot! \\n\\nIt also has a Quest page it is just rooming together with &c&lGenerator Galore&r."]
		}
		quest.4B12425E74C5E511.title: {
			new: "&cExplosive Generator"
			old: "&cExplosive Mycelial Generator"
		}
		quest.4B12425E74C5E511.quest_desc: {
			new: ["The &cExplosive Generator&r does an amazing job at soaking up Explosions. \\n\\nWe could use that for a &d&lPulsating &8Black Hole&r!"]
			old: ["The &cExplosive Mycelial Generator&r does an amazing job at soaking up Explosions. \\n\\nWe could use that for a &d&lPulsating &8Black Hole&r!"]
		}
		quest.76C63670624C3C56.quest_desc: {
			new: ["&e&lExcessive Utilities&r is a continuation of &e&lExtra Utilities 1&r and &e&l2&r, offering various useful items and such. Some of you might remember the mod from older versions of modded Minecraft.\\n\\nWhether this is your first time seeing this mod, or your thousandth, you will need some things from the mod for the &6&lATM Star&r."]
			old: ["&c&lGenerator Galore&r gives us tons of helpful and simple Power Generators! \\n\\nSome can even be combined with each other to be more powerful. \\n\\nThere is a Quest page for them it's just roomates with &7&lIron Furnaces&r."]
		}
	}
	"chapters/mi_digital.snbt": {
